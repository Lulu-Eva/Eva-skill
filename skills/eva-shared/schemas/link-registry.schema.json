{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eva Link Registry",
  "description": "Project-level registry for enabled Eva Links and user-confirmed default intents. This file lives at .eva/links.json in the user's project.",
  "type": "object",
  "required": [
    "version",
    "links",
    "defaults"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "enabled": {
            "type": "boolean"
          },
          "approved_sha256": {
            "description": "SHA-256 fingerprint of the reviewed eva.link.json plus module.md. Any change requires review and a new fingerprint.",
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "approved_at": {
            "description": "When the current user approved this exact Link fingerprint and permission summary.",
            "type": "string",
            "minLength": 1
          },
          "approved_phrase": {
            "description": "Auditable record of the user's enablement confirmation. It is not a cryptographic identity proof.",
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "defaults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "intent",
          "link_id",
          "confirmed",
          "confirmed_at",
          "confirmed_phrase"
        ],
        "properties": {
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "link_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "confirmed": {
            "type": "boolean"
          },
          "confirmed_at": {
            "type": "string",
            "minLength": 1
          },
          "confirmed_phrase": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
