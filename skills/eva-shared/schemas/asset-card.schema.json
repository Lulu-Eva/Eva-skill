{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eva Asset Card",
  "type": "object",
  "required": [
    "asset_type",
    "source_module",
    "core_content",
    "user_question",
    "valid_next",
    "saved"
  ],
  "properties": {
    "asset_type": {
      "type": "string",
      "enum": [
        "inquiry-question-card",
        "reading-lineage-card",
        "learning-progress-card",
        "judgment-version-card",
        "thought-seed-card",
        "core-judgment-card",
        "user-question-card",
        "idea-card",
        "audience-card",
        "title-handoff-card",
        "opening-handoff-card",
        "commercial-constraint-card",
        "content-task-card",
        "content-asset-card",
        "review-card",
        "persona-card",
        "voice-card",
        "product-service-card"
      ]
    },
    "source_module": {
      "type": "string",
      "minLength": 1
    },
    "core_content": {
      "type": ["string", "object", "array"],
      "minLength": 1
    },
    "user_question": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": ["string", "array", "object"]
    },
    "valid_next": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "saved": {
      "type": "boolean"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "facts_confirmed_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["active", "paused", "retired"]
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "low_confidence_reason": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "title-unverified",
          "brief-incomplete",
          "missing-audience",
          "missing-user-question",
          "missing-source-material",
          "user-requested-draft-before-evidence",
          "link-output-schema-failed",
          "missing-title-or-content",
          "missing-data",
          "small-comment-sample",
          "unclear-data-window",
          "missing-user-goal",
          "unverified-causality"
        ]
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "privacy_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_level": {
      "type": "string",
      "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]
    },
    "path_bottleneck": {
      "type": "string",
      "enum": [
        "exposure",
        "click",
        "retention",
        "interaction",
        "profile_visit",
        "follow",
        "consultation",
        "unknown"
      ]
    },
    "facts": {
      "type": ["array", "object", "string"]
    },
    "baseline": {
      "type": ["array", "object", "string"]
    },
    "hypothesis": {
      "type": "string"
    },
    "confounders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alternative_explanations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "falsification_condition": {
      "type": "string",
      "minLength": 1
    },
    "next_test_action": {
      "type": "string"
    },
    "metrics_to_watch": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_backfill_required": {
      "type": "boolean"
    },
    "design_type": {
      "type": "string",
      "enum": [
        "single_observation",
        "baseline_comparison",
        "matched_comparison",
        "natural_experiment",
        "ab_test"
      ]
    },
    "treatment_variable": {
      "type": "string"
    },
    "outcome_variable": {
      "type": "string"
    },
    "control_plan": {
      "type": "string"
    },
    "adjustment_variables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baseline_distribution": {
      "type": ["object", "array", "string"]
    },
    "metric_spec": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role", "numerator", "denominator", "window"],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["primary", "guardrail", "exploratory"]
          },
          "numerator": {
            "type": "string"
          },
          "denominator": {
            "type": "string"
          },
          "window": {
            "type": "string"
          },
          "dedupe_rule": {
            "type": "string"
          },
          "win_threshold": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "business_goal": {
      "type": "string"
    },
    "macro_conversion": {
      "type": "string"
    },
    "micro_conversion": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lead_quality_signal": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outlier_flag": {
      "type": "boolean"
    },
    "outlier_reason": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_criteria": {
      "type": "string"
    },
    "observation_window": {
      "type": "string"
    },
    "learning_log_status": {
      "type": "string",
      "enum": ["success", "failed", "inconclusive"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "asset_type": {
            "const": "product-service-card"
          }
        },
        "required": ["asset_type"]
      },
      "then": {
        "required": [
          "profile_id",
          "revision",
          "facts_confirmed_at",
          "lifecycle_status",
          "evidence"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "facts_confirmed_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "lifecycle_status": {
            "type": "string",
            "enum": ["active", "paused", "retired"]
          },
          "supersedes": {
            "type": "string",
            "minLength": 1
          },
          "core_content": {
            "type": "object",
            "required": [
              "offering_form",
              "can_help_with",
              "fit_situations",
              "help_method",
              "responsible_outcome",
              "boundaries",
              "lifecycle_status"
            ],
            "properties": {
              "offering_form": {
                "type": "string",
                "enum": [
                  "product",
                  "standardized_service",
                  "consulting",
                  "project_collaboration",
                  "professional_capability"
                ]
              },
              "can_help_with": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "array", "minItems": 1},
                  {"type": "object", "minProperties": 1}
                ]
              },
              "fit_situations": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "array", "minItems": 1},
                  {"type": "object", "minProperties": 1}
                ]
              },
              "help_method": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "array", "minItems": 1},
                  {"type": "object", "minProperties": 1}
                ]
              },
              "responsible_outcome": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "array", "minItems": 1},
                  {"type": "object", "minProperties": 1}
                ]
              },
              "boundaries": {
                "oneOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "array", "minItems": 1},
                  {"type": "object", "minProperties": 1}
                ]
              },
              "lifecycle_status": {
                "type": "string",
                "enum": ["active", "paused", "retired"]
              }
            },
            "additionalProperties": true
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["content", "status"],
              "properties": {
                "content": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "user_confirmed",
                    "material_supported_inference",
                    "pending_validation"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
